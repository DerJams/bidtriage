   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Model: z-ai/glm-5.3-flash via OpenRouter\nProvider: pinned only=[deepinfra],\nallow_fallbacks=false, require_parameters=true\nTemperature 0; bounded retry with\nexponential backoff on 429\nIdentical config for baseline and every\nlever, enforced by a single shared\nevals/config.py",
   "originalText": "Model: z-ai/glm-5.3-flash via OpenRouter\nProvider: pinned only=[deepinfra],\nallow_fallbacks=false, require_parameters=true\nTemperature 0; bounded retry with\nexponential backoff on 429\nIdentical config for baseline and every\nlever, enforced by a single shared\nevals/config.py",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "cfg_n",
   "x": 3685,
   "y": 430.0,
   "width": 550,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 150004,
   "version": 1,
   "versionNonce": 150004,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Auto Exacto cannot be pinned and does not\napply to a toolless baseline, so a single\nprovider was pinned instead to keep the two\npaths comparable and the runs reproducible.",
   "originalText": "Auto Exacto cannot be pinned and does not\napply to a toolless baseline, so a single\nprovider was pinned instead to keep the two\npaths comparable and the runs reproducible.",
