   "versionNonce": 900163,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "But the same fix regressed\ncase_12.walkthrough_date from 5/5 to 0/5.",
   "originalText": "But the same fix regressed\ncase_12.walkthrough_date from 5/5 to 0/5.",
