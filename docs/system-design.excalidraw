  {
   "type": "text",
   "id": "leg_b",
   "x": 3578,
   "y": 1691.0,
   "width": 792.0000000000001,
   "height": 250.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 440003,
   "version": 1,
   "versionNonce": 440003,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Solid rectangle = deterministic code (no model call)\nRounded rectangle = model call\nDiamond = decision point\nCylinder = data artifact on disk\nSolid arrow = data flow\nDashed arrow = evaluation / measurement flow\nDashed box outline = built but planned, not yet measured\n\nGrey = deterministic code \u00b7 Blue = model call \u00b7 Violet = data artifact\nTeal = decision \u00b7 Amber = human review or caution \u00b7 Green = eval harness",
   "originalText": "Solid rectangle = deterministic code (no model call)\nRounded rectangle = model call\nDiamond = decision point\nCylinder = data artifact on disk\nSolid arrow = data flow\nDashed arrow = evaluation / measurement flow\nDashed box outline = built but planned, not yet measured\n\nGrey = deterministic code \u00b7 Blue = model call \u00b7 Violet = data artifact\nTeal = decision \u00b7 Amber = human review or caution \u00b7 Green = eval harness",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "noise",
   "x": 90,
   "y": 2240,
   "width": 1089.0,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 450002,
   "version": 1,
   "versionNonce": 450002,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Temperature 0 is NOT deterministic on this provider. Measured spread across identical runs: 2.08pp.\nAny delta below that is noise.",
   "originalText": "Temperature 0 is NOT deterministic on this provider. Measured spread across identical runs: 2.08pp.\nAny delta below that is noise.",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
