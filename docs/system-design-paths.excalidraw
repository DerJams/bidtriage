   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 150004,
   "version": 1,
   "versionNonce": 150004,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Auto Exacto cannot be pinned and does not\napply to a toolless baseline, so a single\nprovider was pinned instead to keep the two\npaths comparable and the runs reproducible.",
   "originalText": "Auto Exacto cannot be pinned and does not\napply to a toolless baseline, so a single\nprovider was pinned instead to keep the two\npaths comparable and the runs reproducible.",
